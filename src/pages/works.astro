---
import Layout from "../layouts/Layout.astro";
import WorkCard from "../components/WorkCard.astro";
import { works } from "../data/works";
---

<Layout title="Works">
  <div class="w-full h-40 sm:h-56 overflow-hidden">
    <img
      src="/works/works-hero.png"
      alt=""
      class="w-full h-full object-cover"
    />
  </div>

  <section class="max-w-[var(--container-max)] mx-auto px-6 pt-16 pb-24">
    <h1 class="font-display font-bold text-4xl mb-12">Works</h1>
    <div class="grid sm:grid-cols-2 gap-6">
      {works.map((work) => (
        <WorkCard work={work} showYear />
      ))}
    </div>
  </section>
</Layout>
