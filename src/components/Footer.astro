---
import T from "./T.astro";

const links = [
  { href: "mailto:manoatelier554@gmail.com", en: "Email", ja: "Email" },
  { href: "https://github.com/t-bfny", en: "GitHub", ja: "GitHub" },
  { href: "https://x.com/yekiponk", en: "X", ja: "X" },
  { href: "/privacy", en: "Privacy", ja: "プライバシーポリシー" },
];
---

<footer class="border-t border-[var(--color-border)] mt-24">
  <div class="max-w-[var(--container-max)] mx-auto px-6 py-10 flex flex-col sm:flex-row justify-between gap-4 text-sm text-[var(--color-fg-muted)]">
    <span>
      &copy; {new Date().getFullYear()} yekipo.tech.{" "}
      <T en="All rights reserved." ja="無断転載を禁じます。" />
    </span>
    <div class="flex gap-6 sm:pr-28">
      {links.map((link) => (
        <a href={link.href} class="transition-colors hover:text-[var(--color-fg)]">
          <T en={link.en} ja={link.ja} />
        </a>
      ))}
    </div>
  </div>
</footer>
