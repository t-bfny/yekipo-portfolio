---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import T from "../components/T.astro";

interface Props {
  title: string;
  description?: string;
  accent?: string; // ページ固有のアクセントカラー(未指定ならグローバルの --color-accent を使用)
}

const { title, description = "yekipo's portfolio", accent } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | yekipo</title>
    <script is:inline>
      // FOUC防止: 描画前に言語設定を <html data-lang> に反映。?lang= はlocalStorageより優先(共有リンク用)
      (function () {
        try {
          var fromQuery = new URLSearchParams(location.search).get("lang");
          var lang = fromQuery || localStorage.getItem("lang");
          if (lang === "ja") {
            document.documentElement.setAttribute("data-lang", "ja");
          }
          if (fromQuery === "ja" || fromQuery === "en") {
            localStorage.setItem("lang", fromQuery);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body style={accent ? `--color-accent: ${accent}` : undefined}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <a
      href="https://buymeacoffee.com/yekipo"
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-5 right-5 z-50 text-sm text-[var(--color-fg-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] rounded-full px-4 py-2 transition-colors hover:text-[var(--color-fg)] hover:border-[var(--color-accent)]"
    >
      <T en="Support" ja="応援する" />
    </a>
  </body>
</html>
